# Copy to .env.local for local development, and add the same two
# variables in Vercel: Project → Settings → Environment Variables.
#
# Find these under your Supabase project's Settings → API page.
# The anon key is safe to expose to the browser — Row Level Security
# (see PizzaPassport/Resources/schema.sql) enforces access control.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional. Not required today — /check-in currently pins a check-in with
# the browser's Geolocation API (no key needed). Set this and wire up the
# Google Places JS Autocomplete widget in app/check-in/page.tsx's PlaceStep
# if you want restaurant-name search instead of a manual name + GPS pin.
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

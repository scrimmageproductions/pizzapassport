# Copy to .env.local for local development, and add the same two
# variables in Vercel: Project → Settings → Environment Variables.
#
# Find these under your Supabase project's Settings → API page.
# The anon key is safe to expose to the browser — Row Level Security
# (see PizzaPassport/Resources/schema.sql) enforces access control.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

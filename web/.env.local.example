# Copy to .env.local for local development, and add the same two
# variables in Vercel: Project → Settings → Environment Variables.
#
# Find these under your Supabase project's Settings → API page.
# The anon key is safe to expose to the browser — Row Level Security
# (see PizzaPassport/Resources/schema.sql) enforces access control.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional. Not required today — nearby pizzeria search already works via
# the free OpenStreetMap tiers in lib/geo.ts. Set this to add Google Places
# as the first tier of that fallback chain (see app/api/places/nearby).
# GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Required only for the merchant portal (/biz). Find it under Settings →
# API → "service_role" — this key bypasses Row Level Security, so it's
# used exclusively in server-only API routes (app/api/merchants/claim),
# never sent to the browser. Do not prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
